NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ─── MongoDB ───────────────────────────────────────────────────────────────────
# Shared MongoDB Atlas cluster — all team members use this same URI
# Get this from the team lead or the project's shared secrets (e.g., Notion, Discord)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/vertex?retryWrites=true&w=majority
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=0
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_min_64_chars
JWT_EXPIRES_IN=7d
LEGAL_PRIVACY_POLICY_VERSION=1.0
LEGAL_TERMS_VERSION=1.0

# ─── Admin Login ──────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_secure_admin_password

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=replace_with_google_client_id

# ─── PayPal ───────────────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=replace_with_paypal_client_id
PAYPAL_CLIENT_SECRET=replace_with_paypal_client_secret
PAYPAL_MODE=sandbox

# ─── Apple OAuth ──────────────────────────────────────────────────────────────
APPLE_CLIENT_ID=replace_with_apple_service_id

# ─── Offline PostgreSQL recovery import (do not use in normal application runtime) ─
# POSTGRES_MIGRATION_URL=postgresql://<username>:<password>@<host>:5432/<database>
# POSTGRES_MIGRATION_SSL=false
# MIGRATION_BATCH_SIZE=100
