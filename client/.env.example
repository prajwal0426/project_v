# Public browser configuration only. Do not place backend secrets in this file.
VITE_GOOGLE_CLIENT_ID=replace_with_google_client_id

# Leave unset for local Vite proxying to http://127.0.0.1:5000.
# VITE_API_BASE_URL=https://api.example.com/api

# Opaque UI route prefix for Admin pages (included in the browser bundle; not a security secret).
# Set a unique, random path before each production build if desired.
VITE_ADMIN_ROUTE_PREFIX=/vx-9e2c7d4a1f83b6c0
